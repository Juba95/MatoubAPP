# === DATABASE ===
DATABASE_URL=postgresql://pbn_user:password@localhost:5432/pbn_manager

# === AUTH ===
JWT_SECRET=change-this-to-a-random-string-64-chars
ADMIN_EMAIL=admin@pbn.local
ADMIN_PASSWORD=change-this-password

# === APIs ===
DATAFORSEO_LOGIN=your-login
DATAFORSEO_PASSWORD=your-password
ANTHROPIC_API_KEY=sk-ant-xxxxx
REPLICATE_API_TOKEN=r8_xxxxx
SEMRUSH_API_KEY=your-semrush-api-key

# === GOOGLE OAUTH (Search Console) ===
# Créer dans Google Cloud Console > APIs > Identifiants > ID Client OAuth 2.0
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=https://ton-dashboard.com/auth/gsc/callback

# === REDIS (pour Celery) ===
REDIS_URL=redis://localhost:6379/0

# === CHIFFREMENT (credentials BDD) ===
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# === CORS ===
# URL(s) autorisées pour le dashboard, séparées par virgule
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# === PROXY (optionnel, anti-footprint) ===
PROXY_URL=
OPENAI_API_KEY=
